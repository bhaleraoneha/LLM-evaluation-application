# 1) Get a FREE key at https://console.groq.com/keys  (no credit card needed)
# 2) Copy this file to ".env" and paste your key below
GROQ_API_KEY=paste_your_key_here

# Model that answers questions (your "app")
GEN_MODEL=openai/gpt-oss-20b
# Model that acts as the "judge" (bigger = better judge)
# If you hit rate limits, set this to openai/gpt-oss-20b too
JUDGE_MODEL=openai/gpt-oss-120b
